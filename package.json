{
  "name": "club-insights",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node --import tsx scripts/seed.ts --if-empty && next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --import tsx scripts/seed.ts --if-empty && next start --hostname 0.0.0.0",
    "seed": "node --import tsx scripts/seed.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.58.0"
  }
}
